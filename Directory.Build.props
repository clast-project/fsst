<Project>

  <!--
    Strong naming.

    The key is deliberately committed: a strong name provides assembly identity,
    not security (the runtime does not validate the signature on .NET Core and
    later), so there is nothing secret to protect. The same key is used across the
    clast-project repositories so every Clast.* assembly carries public key token
    0b0eddb1936076d9.

    ClastPublicKey is the full 2048-bit public key. It is needed verbatim in
    InternalsVisibleTo declarations: the SDK does not append it automatically, and
    a signed assembly may only declare friends that specify a public key (CS1726).
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Clast.snk</AssemblyOriginatorKeyFile>
    <ClastPublicKey></ClastPublicKey>
  </PropertyGroup>

</Project>
